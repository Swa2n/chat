{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]           
}